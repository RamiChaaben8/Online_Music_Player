<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="#FF121212"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <!-- Album art -->
    <ImageView
        android:id="@+id/notification_image"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <!-- Title / Artist / Next song -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="6dp">

        <!-- Song title — ellipsize at end, each field is now short enough -->
        <TextView
            android:id="@+id/notification_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Artist name -->
        <TextView
            android:id="@+id/notification_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#FFB3B3B3"
            android:textSize="11sp" />

        <!-- Next song -->
        <TextView
            android:id="@+id/notification_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#FF1DB954"
            android:textSize="10sp" />

    </LinearLayout>

    <!-- Prev -->
    <ImageButton
        android:id="@+id/notification_prev"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:contentDescription="Previous"
        android:src="@drawable/ic_skip_previous" />

    <!-- Play/Pause -->
    <ImageButton
        android:id="@+id/notification_play_pause"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@android:color/transparent"
        android:contentDescription="Play/Pause"
        android:src="@drawable/ic_play_arrow" />

    <!-- Next -->
    <ImageButton
        android:id="@+id/notification_next_btn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:contentDescription="Next"
        android:src="@drawable/ic_skip_next" />

</LinearLayout>
